        <item>
            <title>0.1.5</title>
            <pubDate>Tue, 13 Oct 2026 12:03:46 +0200</pubDate>
            <sparkle:version>7</sparkle:version>
            <sparkle:shortVersionString>0.1.5</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>Consistent EasySign branding throughout the app.</p><ul><li>A crisp vector logo in the menu bar that adapts to light, dark, and selected states.</li><li>The original full-color logo in the menu panel, welcome screen, and onboarding.</li></ul><p>Includes the setup checks and expanded Recent drafts from 0.1.4. This remains a preview release.</p>]]></description>
            <enclosure url="https://github.com/kavostudio/easysign/releases/download/v0.1.5/EasySign-0.1.5.dmg" length="3950971" type="application/octet-stream" sparkle:edSignature="YHZBUSOY/CKzHk8unzQ52Dh/R4DmGdG/xXZ+sWu5tFhYUAVsQWw+ghH33tPsIIxqdNRU04pNP+e07TJlEZEgBQ=="/>
        </item>
        <item>
            <title>0.1.4</title>
            <pubDate>Tue, 13 Oct 2026 11:23:41 +0200</pubDate>
            <sparkle:version>6</sparkle:version>
            <sparkle:shortVersionString>0.1.4</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<p>EasySign 0.1.4 adds Check Setup and expands Recent drafts by default.</p>
<ul><li>Check signature-folder access, signature compatibility, external changes, lock state, and Mail Automation permission.</li><li>Get clear next steps without losing unsaved HTML.</li><li>Recent drafts starts expanded and can still be collapsed.</li></ul>
<p>Setup checks are read-only. Backup creation and installation are still verified separately during Apply. This remains a preview release.</p>
]]></description>
            <enclosure url="https://github.com/kavostudio/easysign/releases/download/v0.1.4/EasySign-0.1.4.dmg" length="3840757" type="application/octet-stream" sparkle:edSignature="geoIysHBYfMkLZ+ik3KgGgiZJZqB+jecY1UMHQ4g2GJnBfAPtRH8cGXCO8QbUZHppxKbybM939yUMNfteN/NDg=="/>
